#
# Install file for Go32v2/Win32
#
# Warning: no package should contain more than 31 files (32-bit version
# of TV/FV cannot hold more than 31 members of a checkbox group)

title=Free Pascal Compiler 3.3.1
version=3.3.1

#
# Gener~a~l
#
basepath=c:\pp
docsub=doc
helpidx=fpctoc.htm

#
# Go32v2 packages
#
pack=~D~os/Go32v2
binsub=\bin\go32v2
ppc386=ppc386
targetname=go32v2
cfgfile=fpc.cfg
idecfgfile=fp.cfg
ideinifile=fp.ini

filecheck=*dos.zip
# Dos 1
package=basedos.zip[basedos.zip],~B~asic system for Go32v2 (required)
# Dos 2
package=aslddos.zip[aslddos.zip],GNU ~L~inker and GNU Assembler for Go32v2 (required)
# Dos 3
package=units-idedos.zip[uidedos.zip],~I~DE with integrated debugger/compiler (BETA)
# Dos 4
package=utilsdos.zip[utilsdos.zip],~E~xtra Utilities
# Dos 5
package=makedos.zip[makedos.zip],GNU ~U~tilities (needed for Makefile usage)
# Dos 6
package=gdbdos.zip[gdbdos.zip],GNU ~D~ebugger for Go32v2
# Dos 7
package=units-gdbintdos.zip[ugdbdos.zip],GDB Interfacing units
# Dos 8
package=units-paszlibdos.zip[upzldos.zip],PasZLib units
# Dos 9
package=units-regexprdos.zip[uregdos.zip],Regular expression units
# Dos 10
package=units-unzipdos.zip[uzipdos.zip],Unzip units
# Dos 11
package=units-pasjpegdos.zip[upjpdos.zip],Pas~J~PEG units
# Dos 12
package=units-hashdos.zip[uhashdos.zip],Hash calculation units
# Dos 13
package=units-fvdos.zip[ufvdos.zip],Free ~V~ision (FV)
# Dos 14
package=units-graphdos.zip[ugrphdos.zip],Unit Graph
# Dos 15
package=units-fcl-basedos.zip[ufclbdos.zip],Free Component Library (FCL)-base part
# Dos 16
package=units-fcl-dbdos.zip[ufclddos.zip],Free Component Library (FCL)-datasets
# Dos 17
package=units-fcl-fpcunitdos.zip[ufcludos.zip],Free Component Library (FCL)-FPCUnit
# Dos 18
package=units-fcl-imagedos.zip[ufclidos.zip],Free Component Library (FCL)-images
# Dos 19
package=units-fcl-netdos.zip[ufclndos.zip],Free Component Library (FCL)-network
# Dos 20
package=units-fcl-passrcdos.zip[ufclsdos.zip],Free Component Library (FCL)-Pascal source processing
# Dos 21
package=units-fcl-registrydos.zip[ufclrdos.zip],Free Component Library (FCL)-registry
# Dos 22
package=units-fcl-xmldos.zip[ufclxdos.zip],Free Component Library (FCL)-XML
# Dos 23
package=units-fpmkunitdos.zip[ufpmkdos.zip],Units required for building fpmake.exe
# Dos 24
package=units-fcl-jsondos.zip[ufcljdos.zip],Free Component Library (FCL)-JSON interface
# Dos 25
# Dos 26
package=units-chmdos.zip[uchmdos.zip],Support for .chm files handling
# Dos 27
package=units-libgddos.zip[ulgddos.zip],GD library interface unit
# Dos 28
package=units-symbolicdos.zip[usymbdos.zip],Symbolic (unit for parsing and evaluating expressions)
# Dos 29
package=units-fcl-resdos.zip[ufcledos.zip],Free Component Library (FCL)-resources
# Dos 30
package=units-bzip2dos.zip[ubz2dos.zip],Units for bzip2 decompression
# Dos 31
package=units-fcl-jsdos.zip[ufcjsdos.zip],Free Component Library (FCL)-Javascript support

#
# Go32v2 packages 2nd part
#
pack=Dos/~G~o32v2-2
filecheck=*dos.zip
# Dos-2 1
package=units-hermesdos.zip[uhermdos.zip],Port of Hermes graphics library
# Dos-2 2
package=units-fppkgdos.zip[ufppkdos.zip],Units for FPPkg packaging support
# Dos-2 3
package=units-fcl-sounddos.zip[ufsnddos.zip],Free Component Library (FCL)-sound files
