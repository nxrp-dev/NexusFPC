#
# Makefile.fpc for SQL FCL db units
#

[package]
main=fcl-db

[require]
packages=fcl-base fcl-xml
packages_linux=ibase sqlite odbc postgres
packages_freebsd=ibase sqlite odbc postgres
packages_darwin=ibase sqlite odbc postgres
packages_iphonesim=ibase sqlite odbc postgres
packages_netbsd=ibase sqlite odbc postgres
packages_openbsd=ibase sqlite odbc postgres
packages_win32=ibase sqlite odbc postgres
packages_wince=ibase sqlite odbc postgres
packages_win64=sqlite odbc
packages_aix=ibase sqlite odbc postgres

[target]
units=fpdatadict fpdddiff fpdddbf fpddsqldb
units_linux=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
units_freebsd=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
units_darwin=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
units_iphonesim=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
units_netbsd=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
units_openbsd=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
units_win32=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
units_wince=fpddsqlite3
units_win64=fpddodbc fpddsqlite3
units_aix=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts=fpdatadict fpddfb fpddsqldb fpdddiff
rsts_linux=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts_freebsd=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts_darwin=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts_iphonesim=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts_netbsd=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts_openbsd=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts_win32=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd
rsts_wince=fpddfb fpddpq fpddsqlite3
rsts_win64=fpddfb fpddpq fpddodbc fpddsqlite3
rsts_aix=fpddfb fpddodbc fpddpq fpddsqlite3 fpddregstd

[compiler]
options=-S2h

[install]
fpcpackage=y

[default]
fpcdir=../../../..

[rules]
.NOTPARALLEL:
